# Copie para .env.local (ignorado pelo Git). Nunca use NEXT_PUBLIC_ para segredos.
# URL do banco de METADADOS; não é a configuração do futuro motor analítico.
# Formato: postgresql://<usuario>:<senha-percent-encoded>@<host>:<porta>/<database>
# Em conexões remotas, configure TLS conforme o provedor; não desative a validação.
DATABASE_URL=

# Somente para Compose opcional. Preencha usuário/senha localmente.
# DATABASE_URL deve apontar para os mesmos usuário, senha, porta e database.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=analytics_metadata
POSTGRES_PORT=5432

# Integração: database separado, vazio, com nome terminando em _test.
# Nunca reutilize o database de desenvolvimento. Não há fallback para DATABASE_URL.
TEST_DATABASE_URL=
